  "fixed_sql": [
    {
      "name": "filaments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"filaments\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"brand\" TEXT NOT NULL, \"material\" TEXT NOT NULL, \"color_name\" TEXT NOT NULL DEFAULT '', \"color_argb\" INTEGER NULL, \"roll_price_cents\" INTEGER NOT NULL, \"roll_weight_grams\" INTEGER NOT NULL DEFAULT 1000, \"stock_mg\" INTEGER NOT NULL, \"low_stock_alert_mg\" INTEGER NOT NULL DEFAULT 100000, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "printers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"printers\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"power_watts\" INTEGER NOT NULL, \"machine_value_cents\" INTEGER NOT NULL, \"lifespan_hours\" INTEGER NOT NULL, \"maintenance_per_hour_cents\" INTEGER NOT NULL DEFAULT 0, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"currency_code\" TEXT NOT NULL DEFAULT 'BRL', \"locale_code\" TEXT NULL, \"theme_mode\" TEXT NOT NULL DEFAULT 'system', \"kwh_price\" INTEGER NOT NULL DEFAULT 9000, \"labor_hour_cents\" INTEGER NOT NULL DEFAULT 2500, \"marketplace_fee_bp\" INTEGER NOT NULL DEFAULT 0, \"tax_bp\" INTEGER NOT NULL DEFAULT 0, \"default_margin_bp\" INTEGER NOT NULL DEFAULT 3000, \"packaging_cents\" INTEGER NOT NULL DEFAULT 0, \"default_waste_bp\" INTEGER NOT NULL DEFAULT 500, \"default_failure_bp\" INTEGER NOT NULL DEFAULT 500, \"price_rounding\" TEXT NOT NULL DEFAULT 'none', \"shop_name\" TEXT NOT NULL DEFAULT '', \"shop_contact\" TEXT NOT NULL DEFAULT '', \"shop_logo\" BLOB NULL, \"printer_module_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"printer_module_enabled\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "jobs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"jobs\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"customer\" TEXT NULL, \"photo_path\" TEXT NULL, \"notes\" TEXT NULL, \"status\" TEXT NOT NULL, \"quantity\" INTEGER NOT NULL DEFAULT 1, \"printer_id\" INTEGER NULL REFERENCES printers (id) ON DELETE SET NULL, \"printer_name\" TEXT NULL, \"power_watts\" INTEGER NOT NULL DEFAULT 0, \"machine_value_cents\" INTEGER NOT NULL DEFAULT 0, \"lifespan_hours\" INTEGER NOT NULL DEFAULT 0, \"maintenance_per_hour_cents\" INTEGER NOT NULL DEFAULT 0, \"print_seconds\" INTEGER NOT NULL, \"post_process_minutes\" INTEGER NOT NULL, \"kwh_price\" INTEGER NOT NULL, \"labor_hour_cents\" INTEGER NOT NULL, \"packaging_cents\" INTEGER NOT NULL, \"waste_bp\" INTEGER NOT NULL, \"failure_bp\" INTEGER NOT NULL, \"margin_bp\" INTEGER NOT NULL, \"marketplace_fee_bp\" INTEGER NOT NULL, \"tax_bp\" INTEGER NOT NULL, \"price_rounding\" TEXT NOT NULL, \"cost_cents\" INTEGER NOT NULL, \"price_cents\" INTEGER NOT NULL, \"profit_cents\" INTEGER NOT NULL, \"source_file\" TEXT NULL, \"stock_deducted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"stock_deducted\" IN (0, 1)), \"printed_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "job_filaments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"job_filaments\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"job_id\" INTEGER NOT NULL REFERENCES jobs (id) ON DELETE CASCADE, \"filament_id\" INTEGER NULL REFERENCES filaments (id) ON DELETE SET NULL, \"label\" TEXT NOT NULL, \"weight_mg\" INTEGER NOT NULL, \"roll_price_cents\" INTEGER NOT NULL, \"roll_weight_grams\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "printer_connections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"printer_connections\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL DEFAULT 'bambu_lan', \"host\" TEXT NOT NULL, \"serial\" TEXT NOT NULL, \"printer_id\" INTEGER NULL REFERENCES printers (id) ON DELETE SET NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    }
